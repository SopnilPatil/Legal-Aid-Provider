# ==============================================================================
# Legal Aid Provider - Environment Configuration
# Copy this file to 'backend/.env' and fill in your values.
# ==============================================================================

# Database Configuration (MySQL / MariaDB or SQLite)
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3307/legalaid

# Secret Key for JWT Authentication
SECRET_KEY=your_super_secret_jwt_key_change_in_production

# Email Service Settings (Gmail SMTP for password reset links)
MAIL_EMAIL=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

# Frontend URL (Used in password reset emails)
FRONTEND_URL=http://127.0.0.1:3000

# Optional: External LLM API Keys (if applicable)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
