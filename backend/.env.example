# ==============================================================================
# Legal Aid Provider - Environment Configuration
# Duplicate this file as '.env' and fill in your actual values.
# DO NOT commit your real '.env' file containing secrets to GitHub.
# ==============================================================================

# Database Configuration (MySQL / MariaDB or SQLite)
# Example for MySQL: mysql+pymysql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=mysql+pymysql://root:your_mysql_password@127.0.0.1:3307/legalaid

# Secret Key for JWT Authentication (generate a secure random string)
# e.g., run in terminal: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_change_in_production

# Email Service Settings (Gmail SMTP for password reset links)
# Note: For Gmail, create an "App Password" at https://myaccount.google.com/apppasswords
MAIL_EMAIL=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# Ollama LLM Configuration
OLLAMA_URL=http://localhost:11434/api/chat
OLLAMA_MODEL=llama3.2

# Frontend URL (Used in password reset emails)
FRONTEND_URL=http://127.0.0.1:3000

# Optional: External LLM API Keys (if switching from local Ollama)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
